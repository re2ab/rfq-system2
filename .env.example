APP_NAME=RFQ-Core
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database: pick ONE ---
# A) SQLite (easy test / Codespaces without pdo_mysql)
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# B) MySQL (cPanel / production) — comment sqlite lines and use:
# DB_CONNECTION=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=rfq_core
# DB_USERNAME=root
# DB_PASSWORD=

# Never use redis unless extension is installed
CACHE_STORE=file
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=local
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"
